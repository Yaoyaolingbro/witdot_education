# MongoDB
MONGODB_URI=mongodb://localhost:27017/witdot_edu

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Claude API
CLAUDE_API_URL=https://www.dmxapi.cn
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Vision API (图像识别和 AI 生图)
# 如果不单独配置，将复用 Claude API 配置
VISION_API_URL=
VISION_API_KEY=

# Vision 模型配置（三个功能使用不同的模型）
# 1. 图像识别模型（识别物体、场景、文字）
VISION_RECOGNITION_MODEL=claude-3-5-sonnet-20241022

# 2. AI 生图模型（生成图片）
VISION_GENERATION_MODEL=doubao-seedream-4-0-250828

# 3. 提示词优化模型（优化用户输入的生图提示词，可选）
# 如果不设置，默认使用 VISION_RECOGNITION_MODEL
VISION_PROMPT_ENHANCE_MODEL=

# Server
PORT=3210
NODE_ENV=development

# CORS
CLIENT_URL=http://localhost:5432

